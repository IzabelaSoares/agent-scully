# Dublê de `.env` para a suíte. Nenhum valor aqui é credencial nem parece uma:
# o domínio é `.invalido`, TLD reservado que não resolve (RFC 2606).

SCULLY_T_SIMPLES=valor-simples

# O caso que a SPEC §10 registra: `&`, `?` e espaço no mesmo valor. Sem aspas,
# o `&` viraria separador de job em background e a variável não chegaria.
SCULLY_T_ASPAS_SIMPLES='https://exemplo.invalido/hook?a=1&b=2 c'

SCULLY_T_ASPAS_DUPLAS="com espaço e # cerquilha"

# Dentro de aspas nada expande — nem variável, nem comando. É literal.
SCULLY_T_SEM_EXPANSAO='$HOME e $(uname) e `id`'

# Sem aspas, `#` no meio é valor, não comentário: adivinhar aqui erraria em
# silêncio, e valor truncado pela metade é pior que valor estranho.
SCULLY_T_CERQUILHA=a#b

#   Espaço em volta do nome é digitação, não parte do nome.
  SCULLY_T_ESPACADA   =   com-espaco-em-volta

export SCULLY_T_COM_EXPORT=veio-com-export

# Vazia no arquivo continua vazia — e definida.
SCULLY_T_VAZIA=

# Estas duas existem para provar a precedência: o caso as define no ambiente
# antes de carregar, e o valor abaixo NÃO pode ganhar.
SCULLY_T_PRECEDENCIA=valor-do-arquivo
SCULLY_T_PRECEDENCIA_VAZIA=valor-do-arquivo
