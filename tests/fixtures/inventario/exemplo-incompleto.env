# Dublê de `.env.example` ao qual falta uma das cinco informações.
#
# Documenta as duas variáveis que coletor-fake.sh lê — de propósito, para que a
# única coisa errada aqui seja a informação que falta. Canário que falha por
# dois motivos ao mesmo tempo não prova qual dos dois o verificador pegou.

# ─── Fonte de mentira ───────────────────────────────────────────────────────
# Não existe fonte nenhuma: este arquivo é dublê e nada aqui é credencial.
# Conta: nenhuma.
# Emissor: ninguém.
# Escopo: nenhum.
# A linha que diz por quanto tempo vale está ausente, e é isso que o canário
# prova que o verificador pega.
FIXTURE_FONTE_BASE_URL=
FIXTURE_FONTE_API_TOKEN=
